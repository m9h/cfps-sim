matplotlib.use("Agg")
import matplotlib.pyplot as plt
from cfps_sim.model import simulate
construct = read_construct(Path("../constructs/competition/sfgfp.json"))
rr, values = simulate(construct=construct)
fig, axes = plt.subplots(1, 2, figsize=(9, 3.2))
for name in ["ATP", "GTP", "CTP", "UTP"]:
    axes[0].plot(values[:, 0], values[:, values.colnames.index(name)], label=name)
axes[0].set(ylabel="Concentration (mM)", xlabel="Time (min)")
axes[0].legend()
for name in ["Protein", "GFP"]:
    axes[1].plot(values[:, 0], 1000*values[:, values.colnames.index(name)], label=name)
axes[1].set(ylabel="Protein concentration (micromolar)", xlabel="Time (min)")
axes[1].legend()
fig.tight_layout()
Path("figures").mkdir(exist_ok=True)
fig.savefig("figures/trajectory.pdf", bbox_inches="tight")
